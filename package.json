{
  "name": "@dewa-id/signed-qr",
  "version": "0.2.0",
  "description": "Tiny parser for AltID Signed QR and e-Boks SecureQR",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dewa-id/signed-qr-js.git"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist dist-tests",
    "build": "tsc -p src/tsconfig.json",
    "build:test": "tsc -p tests/tsconfig.json",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest"
  },
  "keywords": [
    "signed-qr",
    "secure-qr",
    "m-doc",
    "mdl",
    "sdjwt",
    "dktb",
    "altid",
    "eboks"
  ],
  "author": {
    "name": "Daniel Florescu",
    "url": "https://florescu.dk"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/pako": "^3.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@hexagon/base64": "^2.0.4",
    "cbor2": "^2.3.0",
    "lodash-es": "^4.18.1",
    "pako": "^3.0.2",
    "uint8array-extras": "^1.6.0",
    "uuid": "^14.0.2"
  }
}